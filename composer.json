{
  "name": "supersaas/api-client",
  "version": "2.0.1",
  "description": "Online bookings/appointments/calendars using the SuperSaaS scheduling platform. The SuperSaaS API provides services that can be used to add online booking and scheduling functionality to an existing website or CRM software.",
  "homepage": "https://www.supersaas.com",
  "support": {
    "issues": "https://github.com/SuperSaaS/supersaas-php-api-client/issues",
    "source": "https://github.com/SuperSaaS/supersaas-php-api-client",
    "docs": "https://www.supersaas.com/info/dev",
    "email": "support@supersaas.com"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Kaarle Kulvik",
      "email": "dev@supersaas.com"
    }
  ],
  "keywords": [
    "online appointment schedule",
    "booking calendar",
    "appointment book",
    "reservation system",
    "scheduling software",
    "online booking system",
    "scheduling system",
    "business calendar",
    "supersaas"
  ],
  "require": {
    "php": "~8.3.36 || ~8.4.27 || >=8.5.12"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.7 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "SuperSaaS\\": "src/SuperSaaS/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SuperSaaS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests examples -name '*.php' -print0 | xargs -0 -n1 php -l",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "cs": "phpcs --standard=PSR12 src tests examples"
  },
  "scripts-descriptions": {
    "test": "Run the unit tests",
    "lint": "Check all PHP files for syntax errors",
    "analyse": "Run PHPStan static analysis (with baseline)",
    "cs": "Report PSR-12 coding style violations (informational)"
  },
  "config": {
    "sort-packages": true
  }
}
